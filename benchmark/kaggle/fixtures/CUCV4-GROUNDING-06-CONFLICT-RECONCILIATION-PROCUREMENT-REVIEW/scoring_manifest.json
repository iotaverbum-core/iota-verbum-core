{
  "authoring_status": "draft_surface_v1",
  "axes": [
    "delta_detection",
    "selective_revision",
    "causal_temporal_propagation",
    "unknown_ledger_discipline",
    "evidence_grounding"
  ],
  "axis_weights": {
    "delta_detection": 0.2,
    "evidence_grounding": 0.3,
    "preservation_of_stable_claims": 0.25,
    "structural_propagation": 0.25
  },
  "evidence_grounding_requirement": "Response must cite evidence:corroboration when revising the conflicted branch or elevating the higher-confidence reconciliation path.",
  "hard_fail_conditions": [
    "invalid_json",
    "response_schema_violation",
    "fabricated_ids",
    "fabricated_evidence_ids",
    "preserve_and_retract_same_id"
  ],
  "hard_fail_conditions_natural_language": [
    "Response invents a revised branch that is not supported by evidence:corroboration or the preserved record.",
    "Response fabricates canonical ids or evidence ids not present in the perturbed reference.",
    "Response rewrites preserved sibling branches without new contradictory evidence."
  ],
  "metrics": [
    {
      "axis": "delta_detection",
      "metric_id": "m.changed_states",
      "target_field": "q1_delta_detection.changed_state_ids",
      "type": "exact_match",
      "weight": 1
    },
    {
      "axis": "delta_detection",
      "metric_id": "m.changed_events",
      "target_field": "q1_delta_detection.changed_event_ids",
      "type": "exact_match",
      "weight": 1
    },
    {
      "axis": "causal_temporal_propagation",
      "metric_id": "m.changed_edges",
      "target_field": "q1_delta_detection.changed_edge_ids",
      "type": "set_f1",
      "weight": 1
    },
    {
      "axis": "causal_temporal_propagation",
      "metric_id": "m.changed_scenarios",
      "target_field": "q1_delta_detection.changed_scenario_ids",
      "type": "exact_match",
      "weight": 1
    },
    {
      "axis": "selective_revision",
      "metric_id": "m.new_unknowns_q2",
      "target_field": "q2_revision.newly_relevant_unknown_ids",
      "type": "set_f1",
      "weight": 1
    },
    {
      "axis": "unknown_ledger_discipline",
      "metric_id": "m.new_unknowns_q3",
      "target_field": "q3_unknown_ledger.new_unknown_ids",
      "type": "set_f1",
      "weight": 1
    },
    {
      "axis": "unknown_ledger_discipline",
      "metric_id": "m.resolved_unknowns_q3",
      "target_field": "q3_unknown_ledger.resolved_unknown_ids",
      "type": "set_f1",
      "weight": 1
    }
  ],
  "operational_pass_rule": {
    "citation_coverage_min": 0.67,
    "delta_detection_min": 0.5,
    "overall_min": 0.78
  },
  "penalties": [
    {
      "penalty_id": "p.collateral_damage",
      "trigger_field": "q2_revision.retract_ids",
