    "state:secondary"
  ],
  "revise_branch_ids": [
    "state:primary",
    "state:hop3_dependency"
  ],
  "schema_version": "1.0.0",
  "structural_propagation_requirement": "If a higher-confidence reconciliation record arrives, the revised branch should follow that provenance shift while unaffected sibling branches stay preserved.",
  "weights": {
    "causal_temporal_propagation": 0.25,
    "delta_detection": 0.2,
    "evidence_grounding": 0.25,
    "selective_revision": 0.2,
    "unknown_ledger_discipline": 0.1
