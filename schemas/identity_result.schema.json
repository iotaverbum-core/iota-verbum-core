{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "confidence",
          "support",
          "contradictions",
          "evidence_refs",
          "rationale_trace"
        ],
        "properties": {
          "identity": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "support": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contradictions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale_trace": {
            "type": "string"
          }
        }
      }
    }
  }
}
