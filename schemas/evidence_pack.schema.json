{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/evidence_pack.schema.json",
  "title": "EvidencePack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_version",
    "root_hint",
    "documents",
    "chunks",
    "pack_sha256"
  ],
  "properties": {
    "pack_version": {
      "type": "string",
      "enum": ["1.0", "1.1"]
    },
    "root_hint": {
      "type": "string"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_docs",
        "max_total_words",
        "max_total_chunks",
        "chunk_target_words",
        "chunk_overlap_words"
      ],
      "properties": {
        "max_docs": {"type": "integer", "minimum": 1},
        "max_total_words": {"type": "integer", "minimum": 1},
        "max_total_chunks": {"type": "integer", "minimum": 1},
        "chunk_target_words": {"type": "integer", "minimum": 1},
        "chunk_overlap_words": {"type": "integer", "minimum": 0}
      }
    },
    "corpus_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_docs", "total_words", "documents"],
      "properties": {
        "total_docs": {"type": "integer", "minimum": 0},
        "total_words": {"type": "integer", "minimum": 0},
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "doc_id",
              "relative_path",
              "content_sha256",
              "byte_count",
              "char_count",
              "word_count",
              "title",
              "detected_categories",
              "detected_headings_summary"
            ],
            "properties": {
              "doc_id": {"type": "string", "minLength": 1},
              "relative_path": {"type": "string", "minLength": 1},
              "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "byte_count": {"type": "integer", "minimum": 0},
              "char_count": {"type": "integer", "minimum": 0},
              "word_count": {"type": "integer", "minimum": 0},
              "title": {"type": "string"},
              "detected_categories": {"type": "array", "items": {"type": "string"}},
              "detected_headings_summary": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "document_structure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "doc_id",
          "relpath",
          "sha256",
          "bytes"
        ],
        "properties": {
          "doc_id": {"type": "string", "minLength": 1},
          "relpath": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "byte_count": {"type": "integer", "minimum": 0},
          "char_count": {"type": "integer", "minimum": 0},
          "word_count": {"type": "integer", "minimum": 0},
          "title": {"type": "string"},
          "detected_categories": {"type": "array", "items": {"type": "string"}},
          "detected_headings_summary": {"type": "array", "items": {"type": "string"}
          }
        }
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "doc_id",
          "chunk_id",
          "index",
          "offset_start",
          "offset_end",
          "text",
          "text_sha256"
        ],
        "properties": {
          "doc_id": {"type": "string", "minLength": 1},
          "section_id": {"type": "string"},
          "chunk_id": {"type": "string", "minLength": 1},
          "index": {"type": "integer", "minimum": 0},
          "chunk_index_in_doc": {"type": "integer", "minimum": 0},
          "global_chunk_index": {"type": "integer", "minimum": 0},
          "offset_start": {"type": "integer", "minimum": 0},
          "offset_end": {"type": "integer", "minimum": 0},
          "text": {"type": "string"},
          "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "heading_path": {"type": "array", "items": {"type": "string"}},
          "title": {"type": "string"},
          "categories": {"type": "array", "items": {"type": "string"}},
          "relative_path": {"type": "string"},
          "word_count": {"type": "integer", "minimum": 0},
          "char_count": {"type": "integer", "minimum": 0},
          "neighbor_section_ids": {"type": "array", "items": {"type": "string"}},
          "section_context_keywords": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "pack_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
