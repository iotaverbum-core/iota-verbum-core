{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stable_timestamp_policy",
    "run_config",
    "stage_hashes"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "stable_timestamp_policy": {
      "type": "string"
    },
    "run_config": {
      "type": "object"
    },
    "stage_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
