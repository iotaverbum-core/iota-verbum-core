{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOTA VERBUM CORE legal_contract output",
  "type": "object",
  "required": [
    "domain",
    "schema_version",
    "extraction",
    "review_findings",
    "review_summary"
  ],
  "properties": {
    "domain": {
      "const": "legal_contract"
    },
    "schema_version": {
      "const": "1.2"
    },
    "governance_metadata": {
      "type": "object",
      "required": ["eu_ai_act_article", "nist_rmf_function", "risk_tier", "audit_ready"],
      "properties": {
        "eu_ai_act_article": { "type": "string" },
        "nist_rmf_function": {
          "type": "string",
          "enum": ["GOVERN", "MAP", "MEASURE", "MANAGE"]
        },
        "risk_tier": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "audit_ready": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "neurosymbolic_boundary": {
      "type": "object",
      "required": [
        "symbolic_components_used",
        "neural_components_used",
        "neural_override_count",
        "symbolic_confidence",
        "boundary_version"
      ],
      "properties": {
        "symbolic_components_used": {
          "type": "array",
          "items": { "type": "string" }
        },
        "neural_components_used": {
          "type": "array",
          "items": { "type": "string" }
        },
        "neural_override_count": { "type": "integer" },
        "symbolic_confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "boundary_version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "extraction": {
      "type": "object",
      "required": [
        "parties",
        "effective_date",
        "term",
        "obligations",
        "rights",
        "prohibitions",
        "defined_terms",
        "governing_law",
        "termination_conditions",
        "conditional_triggers",
        "analysis",
        "risk_report",
        "extraction_warnings"
      ],
      "properties": {
        "parties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": {"type": "string"},
              "role": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "effective_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "term": {
          "type": "object",
          "required": ["start", "end", "duration_string"],
          "properties": {
            "start": {"type": ["string", "null"]},
            "end": {"type": ["string", "null"]},
            "duration_string": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["party", "text", "offset", "action", "polarity"],
            "properties": {
              "party": {"type": "string"},
              "text": {"type": "string"},
              "offset": {"type": "integer", "minimum": 0},
              "action": {"type": "string"},
              "polarity": {
                "type": "string",
                "enum": ["positive", "negative"]
              }
            },
            "additionalProperties": false
          }
        },
        "rights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["party", "text", "offset", "action"],
            "properties": {
              "party": {"type": "string"},
              "text": {"type": "string"},
              "offset": {"type": "integer", "minimum": 0},
              "action": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "prohibitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["party", "text", "offset", "action"],
            "properties": {
              "party": {"type": "string"},
              "text": {"type": "string"},
              "offset": {"type": "integer", "minimum": 0},
              "action": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "defined_terms": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "governing_law": {
          "type": "object",
          "required": ["jurisdiction", "full_clause"],
          "properties": {
            "jurisdiction": {"type": ["string", "null"]},
            "full_clause": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "termination_conditions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "conditional_triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["condition", "consequence", "offset", "text"],
            "properties": {
              "condition": {"type": "string"},
              "consequence": {"type": "string"},
              "offset": {"type": "integer", "minimum": 0},
              "text": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "analysis": {
          "type": "object",
          "required": [
            "executive_summary",
            "contradictions",
            "ambiguities",
            "risk_registry"
          ],
          "properties": {
            "executive_summary": {
              "type": "object",
              "required": [
                "risk_score",
                "contradiction_count",
                "ambiguity_count",
                "highest_severity",
                "headline"
              ],
              "properties": {
                "risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
                "contradiction_count": {"type": "integer", "minimum": 0},
                "ambiguity_count": {"type": "integer", "minimum": 0},
                "highest_severity": {
                  "type": "string",
                  "enum": ["low", "medium", "high"]
                },
                "headline": {"type": "string"}
              },
              "additionalProperties": false
            },
            "contradictions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "contradiction_id",
                  "contradiction_type",
                  "title",
                  "description",
                  "party",
                  "beneficiary",
                  "action",
                  "severity",
                  "left_clause_text",
                  "left_clause_offset",
                  "right_clause_text",
                  "right_clause_offset"
                ],
                "properties": {
                  "contradiction_id": {"type": "string"},
                  "contradiction_type": {"type": "string"},
                  "title": {"type": "string"},
                  "description": {"type": "string"},
                  "party": {"type": "string"},
                  "beneficiary": {"type": "string"},
                  "action": {"type": "string"},
                  "severity": {
                    "type": "string",
                    "enum": ["low", "medium", "high"]
                  },
                  "left_clause_text": {"type": "string"},
                  "left_clause_offset": {"type": "integer", "minimum": 0},
                  "right_clause_text": {"type": "string"},
                  "right_clause_offset": {"type": "integer", "minimum": 0}
                },
                "additionalProperties": false
              }
            },
            "ambiguities": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "ambiguity_id",
                  "party",
                  "term",
                  "text",
                  "offset",
                  "risk_level"
                ],
                "properties": {
                  "ambiguity_id": {"type": "string"},
                  "party": {"type": "string"},
                  "term": {"type": "string"},
                  "text": {"type": "string"},
                  "offset": {"type": "integer", "minimum": 0},
                  "risk_level": {
                    "type": "string",
                    "enum": ["low", "medium", "high"]
                  }
                },
                "additionalProperties": false
              }
            },
            "risk_registry": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "risk_id",
                  "risk_type",
                  "severity",
                  "title",
                  "party",
                  "action",
                  "beneficiary",
                  "evidence_offsets"
                ],
                "properties": {
                  "risk_id": {"type": "string"},
                  "risk_type": {"type": "string"},
                  "severity": {
                    "type": "string",
                    "enum": ["low", "medium", "high"]
                  },
                  "title": {"type": "string"},
                  "party": {"type": ["string", "null"]},
                  "action": {"type": ["string", "null"]},
                  "beneficiary": {"type": ["string", "null"]},
                  "evidence_offsets": {
                    "type": "array",
                    "items": {"type": "integer", "minimum": 0}
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "risk_report": {
          "type": "object",
          "required": [
            "executive_summary",
            "top_risks",
            "conditional_trigger_count",
            "rights_count",
            "prohibition_count"
          ],
          "properties": {
            "executive_summary": {
              "$ref": "#/properties/extraction/properties/analysis/properties/executive_summary"
            },
            "top_risks": {
              "type": "array",
              "items": {
                "$ref": "#/properties/extraction/properties/analysis/properties/risk_registry/items"
              }
            },
            "conditional_trigger_count": {"type": "integer", "minimum": 0},
            "rights_count": {"type": "integer", "minimum": 0},
            "prohibition_count": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "extraction_warnings": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "review_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "finding_class",
          "category",
          "severity",
          "title",
          "summary",
          "source_path",
          "evidence_offsets",
          "review_required",
          "related_party",
          "related_action",
          "details"
        ],
        "properties": {
          "finding_id": { "type": "string" },
          "finding_class": {
            "type": "string",
            "enum": ["contradiction", "ambiguity", "warning", "clause_detected"]
          },
          "category": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "source_path": { "type": "string" },
          "evidence_offsets": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          },
          "review_required": { "type": "boolean" },
          "related_party": { "type": ["string", "null"] },
          "related_action": { "type": ["string", "null"] },
          "details": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "review_summary": {
      "type": "object",
      "required": [
        "status",
        "priority",
        "headline",
        "finding_count",
        "warning_count",
        "requires_human_review"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ready_for_review", "review_required"]
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "headline": { "type": "string" },
        "finding_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 },
        "requires_human_review": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
