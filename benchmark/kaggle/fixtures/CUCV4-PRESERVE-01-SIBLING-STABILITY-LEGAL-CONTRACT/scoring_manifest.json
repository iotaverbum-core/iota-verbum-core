    "response_schema_violation",
    "fabricated_ids",
    "fabricated_evidence_ids",
    "preserve_and_retract_same_id"
  ],
  "hard_fail_conditions_natural_language": [
    "Response states the penalty remains fully admitted after CL-0055-R.",
