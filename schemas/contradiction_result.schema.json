{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "supported_classes",
    "contradictions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "supported_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "reason",
          "refs"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "refs": {
            "type": "array"
          }
        }
      }
    }
  }
}
